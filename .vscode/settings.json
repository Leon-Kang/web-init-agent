{
  // dprint handles all formatting
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "dprint.dprint",

  // Biome handles JS/TS linting only (formatter is disabled in biome.json)
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit"
  },

  // Stylelint handles CSS linting — disable VS Code built-in CSS validation
  "stylelint.enable": true,
  "stylelint.validate": ["css"],
  "css.validate": false,
  "scss.validate": false,
  "less.validate": false,

  // Always use workspace TypeScript version
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // File associations
  "files.associations": {
    "*.css": "css"
  },

  // Exclude generated dirs from search
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/out": true,
    "**/.next": true,
    "**/.astro": true,
    "**/coverage": true
  }
}
